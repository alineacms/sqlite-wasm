{
  "name": "@alinea/sqlite-wasm",
  "version": "0.8.0",
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alineacms/sqlite-wasm.git"
  },
  "type": "module",
  "types": "./dist/init-base64.d.ts",
  "exports": {
    ".": {
      "edge": "./dist/init-edge.js",
      "edge-light": "./dist/init-edge.js",
      "worker": "./dist/init-wasm.js",
      "default": "./dist/init-base64.js"
    },
    "./native": "./dist/native.js",
    "./indexeddb": "./dist/indexeddb.js",
    "./opfs": "./dist/opfs.js",
    "./snapshots": "./dist/snapshots.js",
    "./file": "./dist/file.js",
    "./package.json": "./package.json",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "make build-dist && bun run build:native",
    "build:native": "bun script/build-native.ts && esbuild --format=esm --minify --platform=node src/native.ts --outdir=dist",
    "build:ts": "tsc && cp src/sqlite3-emscripten.d.ts dist/sqlite3-emscripten.d.ts",
    "clean": "make clean",
    "test:browser": "bun script/test-browser.ts"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@alinea/suite": "0.6.3",
    "@types/bun": "1.4.1",
    "@types/emscripten": "1.41.6",
    "@types/sql.js": "1.4.11",
    "buffer-to-base64": "0.1.6",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "google-closure-compiler": "20260831.0.0",
    "playwright-core": "1.63.0",
    "terser": "5.51.2",
    "typescript": "7.0.2"
  }
}
